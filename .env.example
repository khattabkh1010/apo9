# Copy to .env for local overrides. NEVER commit real secrets. In production every secret below is
# REQUIRED (the API refuses to start without them) and must come from a secret manager.
NODE_ENV=development
PORT=8080
# Production: postgres://USER:PASS@HOST:5432/abu9?sslmode=verify-full  (required for non-local hosts)
DATABASE_URL=postgres://abu9:abu9_dev@127.0.0.1:5432/abu9
TEST_# Production: postgres://USER:PASS@HOST:5432/abu9?sslmode=verify-full  (required for non-local hosts)
DATABASE_URL=postgres://abu9:abu9_dev@127.0.0.1:5432/abu9_test
DB_POOL_MAX=10
DATABASE_CA_CERT=        # PEM text or file path of the DB server CA (managed Postgres CA bundle)

# Secrets (dev defaults are used only when NODE_ENV != production)
OTP_HMAC_SECRET=
PAYMENT_WEBHOOK_SECRET=
MFA_ENCRYPTION_KEY=     # seals staff TOTP secrets at rest (AES-256-GCM); rotate with re-enrolment

# HTTP security
TRUST_PROXY=0           # 1 only behind a trusted load balancer (X-Forwarded-For used for rate limits)
RATE_LIMIT=1            # in-process limits; move counters to Redis when running >1 instance
SECURE_COOKIES=0        # forced on in production (HTTPS only)
STAFF_MFA=1             # TOTP for ops/finance/admin; cannot be disabled in production

# Providers — "mock" is refused when NODE_ENV=production
PAYMENT_PROVIDER=mock
SMS_PROVIDER=mock

# Dev conveniences
OTP_DEV_ECHO=1          # return OTP / staff TOTP code in API responses (forced off in production)
JOBS_ENABLED=1          # in-process background jobs
LOG_LEVEL=info
MIGRATE_ON_START=0
MEDIA_DIR=              # defaults to apps/api/storage/media
