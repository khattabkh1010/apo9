{
  "name": "abu9",
  "private": true,
  "version": "0.1.0",
  "description": "ABU9 (أبو9) — Saudi food discovery, ordering and delivery platform. Monorepo.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 --test-reporter=spec \"packages/*/test/*.test.ts\" \"apps/*/test/*.test.ts\"",
    "test:unit": "node --test --test-reporter=spec \"packages/domain/test/*.test.ts\"",
    "db:migrate": "node packages/db/src/migrate.ts",
    "db:seed": "node packages/db/src/seed.ts",
    "db:reset": "node packages/db/src/migrate.ts --reset && node packages/db/src/seed.ts",
    "build:web": "node apps/web/build.ts",
    "openapi": "node apps/api/src/openapi/write.ts",
    "dev": "node apps/web/build.ts && node --watch apps/api/src/main.ts",
    "start": "node apps/api/src/main.ts",
    "screenshots": "node scripts/screenshots.mjs docs/screenshots",
    "test:e2e": "node --test --test-reporter=spec apps/api/test/e2e.test.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "typescript": "^6.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  }
}